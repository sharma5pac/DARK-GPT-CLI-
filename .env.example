# OpenRouter (default provider). Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here

# NVIDIA NIM direct — avoids OpenRouter's free-models-per-day cap.
# Free key: https://build.nvidia.com/settings/api-keys
# Then run /provider nvidia in the TUI.
# NVIDIA_API_KEY=your-nvidia-key-here
