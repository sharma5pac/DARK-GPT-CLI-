/* DarkGPT TUI theme */

Screen {
    background: #0d0d0d;
    color: #d4d4d4;
}

/* ----------------------------------------------------------------- header */

#header {
    dock: top;
    height: 1;
    background: #141414;
    color: #bdbdbd;
    padding: 0 1;
}

#header-left {
    width: 1fr;
    height: 1;
    content-align: left middle;
    color: #9a9a9a;
}

#header-badges {
    width: auto;
    height: 1;
    align: right middle;
}

#session-bar {
    width: auto;
    height: 1;
    align: left middle;
    margin: 0 1;
}

.session-current {
    height: 1;
    min-width: 16;
    width: auto;
    content-align: left middle;
    color: #8ab4f8;
    background: #161616;
    padding: 0 1;
    margin: 0 0 0 1;
}

.badge {
    min-width: 9;
    width: auto;
    height: 1;
    margin: 0 0 0 1;
    padding: 0 1;
    border: none;
    background: #1c1c1c;
    color: #b8b8b8;
    text-style: none;
}

.badge:hover {
    background: #2a2a2a;
    color: #e5e5e5;
}

.badge.-active,
.badge:focus {
    background: #2d2618;
    color: #e5a93c;
}

/* ------------------------------------------------------------------- body */

#body {
    height: 1fr;
    background: #0d0d0d;
}

#conversation {
    height: 1fr;
    padding: 0 1;
    background: #0d0d0d;
    scrollbar-gutter: stable;
}

/* ---------------------------------------------------------------- palette */

#palette {
    display: none;
    height: auto;
    max-height: 9;
    margin: 0 1;
    border: round #3a3a3a;
    background: #161616;
    color: #d4d4d4;
    padding: 0;
}

#palette > .option-list--option-highlighted {
    background: #2d2618;
    color: #e5a93c;
}

/* -------------------------------------------------------------- liveness */

#liveness-bar {
    height: 1;
    padding: 0 2;
    background: #0d0d0d;
    color: #6f6f6f;
}

#liveness-bar.active {
    background: #1a1408;
    color: #e5a93c;
}

/* ----------------------------------------------------------------- prompt */

#prompt-wrap {
    dock: bottom;
    height: auto;
    max-height: 16;
    background: #0d0d0d;
    padding: 0 1 1 1;
}

#prompt-box {
    height: auto;
    border: round #333333;
    background: #141414;
    padding: 0;
}

#prompt-box:focus-within {
    border: round #e5a93c;
}

#prompt-input {
    height: auto;
    max-height: 10;
    border: none;
    background: #141414;
    padding: 0 1;
}

#prompt-input:focus {
    background: #141414;
}

#hint-line {
    height: 1;
    padding: 0 1;
    background: #141414;
    color: #e5a93c;
    text-style: bold;
}

#prompt-footer {
    height: 1;
    padding: 0 1;
    background: #141414;
    color: #777777;
}

.footer-btn.mode-build {
    background: #123322;
    color: #74d99b;
    text-style: bold;
}

.footer-btn.mode-ask {
    background: #3a2a10;
    color: #ffcf70;
    text-style: bold;
}

.footer-btn {
    height: 1;
    min-width: 5;
    width: auto;
    margin: 0 1 0 0;
    padding: 0 1;
    border: none;
    background: #1c1c1c;
    color: #9a9a9a;
    text-style: none;
}

.footer-btn:hover {
    background: #2a2a2a;
    color: #e5e5e5;
}

.footer-btn:focus {
    background: #2d2618;
    color: #e5a93c;
}

.footer-info {
    height: 1;
    width: auto;
    padding: 0 1 0 0;
    color: #6f6f6f;
    content-align: right middle;
}

#token-label {
    width: 1fr;
    height: 1;
    content-align: right middle;
    color: #777777;
    padding: 0 1 0 0;
}

/* ------------------------------------------------------------------ cards */

ToolCard {
    border: solid #2e2e2e;
    background: #1a1a1a;
    margin: 1 0;
    padding: 0 1;
    height: auto;
}

ToolCard:focus {
    border: solid #e5a93c;
}

ErrorCard {
    border: solid #7a2f2f;
    background: #1e1212;
    margin: 1 0;
    padding: 0 1;
    height: auto;
}

DiffCard {
    border: solid #2c3d55;
    background: #121820;
    margin: 1 0;
    padding: 0 1;
    height: auto;
}

BackgroundIndicator {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    color: #8a8a8a;
    background: #141414;
    border: round #2a2a2a;
}

BackgroundIndicator.running {
    color: #d4a359;
    border: round #5a4520;
}

ActivitySpinner {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    background: #141414;
    border: round #2a2a2a;
}

FindingCard {
    border: round #2e3d33;
    background: #141a16;
    margin: 1 0;
    padding: 1;
    height: auto;
}

FindingCard:focus {
    border: round #6abf69;
}

.system-note {
    margin: 0 0 1 0;
    padding: 0 1;
    color: #8a8a8a;
}

ThoughtBlock {
    margin: 1 0;
    height: auto;
    color: #d4a359;
    padding: 1;
    border: round #5a4520;
    background: #17130d;
}

ThoughtBlock:focus {
    border: round #e5a93c;
}

ThoughtBlock.plan-box {
    color: #8ab4f8;
    border: round #355070;
    background: #101722;
}

ThoughtBlock.plan-box:focus {
    border: round #8ab4f8;
}

PhaseTimeline {
    margin: 1 0;
    padding: 0 1;
    height: auto;
    background: #111111;
    border: solid #242424;
    color: #c9d1d9;
}

.msg-user {
    margin: 1 0;
    padding: 1;
    color: #f0f0f0;
    border: round #3a3a3a;
    background: #121212;
    height: auto;
}

.msg-assistant {
    margin: 1 0;
    padding: 1;
    height: auto;
    border: round #2f6b4a;
    border-left: thick #49c17e;
    background: #12251b;
    color: #dff3e6;
}

ChatMessage Markdown, .msg-assistant Markdown {
    background: transparent;
    margin: 0;
    padding: 0;
    height: auto;
}

ChatMessage {
    height: auto;
    transition: offset 220ms in_out_cubic, opacity 220ms in_out_cubic;
}

ChatMessage Static {
    height: auto;
}

.msg-meta {
    height: auto;
    color: #777777;
    padding: 0 0 1 0;
}

/* ----------------------------------------------------------------- modals */

.modal {
    width: 70%;
    max-width: 110;
    height: auto;
    max-height: 85%;
    margin: 1 2;
    padding: 1 2;
    border: round #e5a93c;
    background: #141414;
    color: #d4d4d4;
}

.modal.wide {
    width: 85%;
    max-width: 140;
    height: 80%;
}

.modal.small {
    width: 55%;
    max-width: 80;
    height: auto;
}

.modal-title {
    width: 100%;
    height: 1;
    margin: 0 0 1 0;
    color: #e5a93c;
    text-style: bold;
    content-align: left middle;
}

.modal-help {
    width: 100%;
    height: 1;
    margin: 1 0 0 0;
    color: #777777;
    content-align: left middle;
}

.modal Input {
    height: 3;
    margin: 0 0 1 0;
    border: round #333333;
    background: #1a1a1a;
    color: #e5e5e5;
}

.modal Input:focus {
    border: round #e5a93c;
}

.modal OptionList {
    height: 1fr;
    min-height: 6;
    border: round #2e2e2e;
    background: #111111;
    color: #d4d4d4;
}

.modal OptionList > .option-list--option-highlighted {
    background: #2d2618;
    color: #e5a93c;
}

.details {
    height: 1fr;
    min-height: 5;
    margin: 1 0 0 0;
    padding: 0 1;
    border: round #2e2e2e;
    background: #101010;
    color: #b8b8b8;
}

.modal TextArea {
    height: 8;
    margin: 0 0 1 0;
    border: round #333333;
    background: #1a1a1a;
    color: #e5e5e5;
}

.modal TextArea:focus {
    border: round #e5a93c;
}

.button-row {
    width: 100%;
    height: auto;
    align: right middle;
    margin: 1 0 0 0;
}

.button-row Button {
    width: auto;
    min-width: 10;
    height: 1;
    margin: 0 0 0 1;
    border: none;
    background: #242424;
    color: #d4d4d4;
    text-style: none;
}

.button-row Button:hover {
    background: #333333;
    color: #ffffff;
}

.button-row Button.-primary {
    background: #8a6a1f;
    color: #ffffff;
}

.button-row Button.-error {
    background: #7a2f2f;
    color: #ffffff;
}

.error-text {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
    color: #e06c75;
}

SubagentCard {
    border: solid #4d3a66;
    background: #16121e;
    margin: 1 0;
    padding: 0 1;
    height: auto;
}
