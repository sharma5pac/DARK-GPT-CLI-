/* DarkGPT TUI theme */

Screen {
    background: #0d0d0d;
    color: #d4d4d4;
}

/* ----------------------------------------------------------------- header */

#header {
    dock: top;
    height: 1;
    background: #141414;
    color: #bdbdbd;
    padding: 0 1;
}

#header-left {
    width: 1fr;
    height: 1;
    content-align: left middle;
    color: #9a9a9a;
}

#header-badges {
    width: auto;
    height: 1;
    align: right middle;
}

#session-bar {
    width: auto;
    height: 1;
    align: left middle;
    margin: 0 1;
}

.session-current {
    height: 1;
    min-width: 16;
    width: auto;
    content-align: left middle;
    color: #8ab4f8;
    background: #161616;
    padding: 0 1;
    margin: 0 0 0 1;
}

.badge {
    min-width: 9;
    width: auto;
    height: 1;
    margin: 0 0 0 1;
    padding: 0 1;
    border: none;
    background: #1c1c1c;
    color: #b8b8b8;
    text-style: none;
}

.badge:hover {
    background: #2a2a2a;
    color: #e5e5e5;
}

.badge.-active,
.badge:focus {
    background: #2d2618;
    color: #e5a93c;
}

/* ------------------------------------------------------------------- body */

#body {
    height: 1fr;
    background: #0d0d0d;
}

#conversation {
    height: 1fr;
    padding: 0 1;
    background: #0d0d0d;
    scrollbar-gutter: stable;
}

/* ---------------------------------------------------------------- palette */

#palette {
    display: none;
    height: auto;
    max-height: 9;
    margin: 0 1;
    border: round #3a3a3a;
    background: #161616;
    color: #d4d4d4;
    padding: 0;
}

#palette > .option-list--option-highlighted {
    background: #2d2618;
    color: #e5a93c;
}

/* -------------------------------------------------------------- liveness */

#liveness-bar {
    height: 1;
    padding: 0 2;
    background: #0d0d0d;
    color: #6f6f6f;
}

#liveness-bar.active {
    background: #1a1408;
    color: #e5a93c;
}

/* ----------------------------------------------------------------- prompt */

#prompt-wrap {
    dock: bottom;
    height: auto;
    max-height: 22;
    background: #0d0d0d;
    padding: 0 1 1 1;
}

/* Live implementation plan sits immediately above the input box. */
#plan-panel {
    height: auto;
    max-height: 8;
    padding: 0 1;
    border-top: solid #333333;
    background: #101010;
    color: #8b949e;
}

#plan-panel.hidden {
    display: none;
}

#prompt-box {
    height: auto;
    border: round #333333;
    background: #141414;
    padding: 0;
}

#prompt-box:focus-within {
    border: round #e5a93c;
}

#prompt-input {
    height: auto;
    max-height: 10;
    border: none;
    background: #141414;
    padding: 0 1;
}

#prompt-input:focus {
    background: #141414;
}

#hint-line {
    height: 1;
    padding: 0 1;
    background: #141414;
    color: #e5a93c;
    text-style: bold;
}

#prompt-footer {
    height: 1;
    padding: 0 1;
    background: #141414;
    color: #777777;
}

.footer-btn.mode-build {
    background: #123322;
    color: #74d99b;
    text-style: bold;
}

.footer-btn.mode-ask {
    background: #3a2a10;
    color: #ffcf70;
    text-style: bold;
}

.footer-btn {
    height: 1;
    min-width: 5;
    width: auto;
    margin: 0 1 0 0;
    padding: 0 1;
    border: none;
    background: #1c1c1c;
    color: #9a9a9a;
    text-style: none;
}

.footer-btn:hover {
    background: #2a2a2a;
    color: #e5e5e5;
}

.footer-btn:focus {
    background: #2d2618;
    color: #e5a93c;
}

.footer-info {
    height: 1;
    width: auto;
    padding: 0 1 0 0;
    color: #6f6f6f;
    content-align: right middle;
}

#token-label {
    width: 1fr;
    height: 1;
    content-align: right middle;
    color: #777777;
    padding: 0 1 0 0;
}

/* ------------------------------------------------------------------ cards */

/* Claude-Code style: interim activity is a dim one-line entry. Enter/click
   expands it; only the final assistant answer gets a large panel. */
.compact-card {
    height: auto;
    margin: 0;
    padding: 0 1;
    border: none;
    background: transparent;
    color: #8a8a8a;
}

.compact-card:focus {
    background: #181818;
    color: #d4d4d4;
}

ErrorCard {
    border: solid #7a2f2f;
    background: #1e1212;
    margin: 1 0;
    padding: 0 1;
    height: auto;
}

BackgroundIndicator {
    height: auto;
    margin: 0;
    padding: 0 1;
    color: #8a8a8a;
    background: transparent;
    border: none;
}

BackgroundIndicator.running {
    color: #d4a359;
}

ActivitySpinner {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    background: transparent;
    border: none;
}

.system-note {
    margin: 0;
    padding: 0 1;
    color: #8a8a8a;
}

ThoughtBlock.plan-box {
    color: #8ab4f8;
}

PhaseTimeline {
    margin: 0 0 1 0;
    padding: 0 1;
    height: auto;
    background: transparent;
    border: none;
    color: #8b949e;
}

.msg-user {
    margin: 1 0 0 0;
    padding: 0 1;
    color: #cfcfcf;
    border: none;
    background: transparent;
    height: auto;
}

/* The final answer is the only large, bordered block in the transcript. */
.msg-assistant {
    margin: 1 0 2 0;
    padding: 1 2;
    min-height: 3;
    height: auto;
    border: none;
    border-left: thick #49c17e;
    background: #101c15;
    color: #e2f3e8;
}

ChatMessage Markdown, .msg-assistant Markdown {
    background: transparent;
    margin: 0;
    padding: 0;
    height: auto;
}

.msg-assistant Markdown {
    padding: 0 1;
}

ChatMessage {
    height: auto;
    transition: offset 220ms in_out_cubic, opacity 220ms in_out_cubic;
}

ChatMessage Static {
    height: auto;
}

.msg-meta {
    height: auto;
    color: #777777;
    padding: 0 0 1 0;
}

/* ----------------------------------------------------------------- modals */

ModalScreen {
    align: center middle;
    background: #050505cc;
}

.modal {
    width: 70%;
    max-width: 110;
    height: auto;
    max-height: 85%;
    margin: 1 2;
    padding: 1 2;
    border: round #e5a93c;
    background: #141414;
    color: #d4d4d4;
}

.modal.wide {
    width: 85%;
    max-width: 140;
    height: 80%;
}

.modal.small {
    width: 55%;
    max-width: 80;
    height: auto;
}

.modal-title {
    width: 100%;
    height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    border-left: wide #e5a93c;
    color: #e5a93c;
    text-style: bold;
    content-align: left middle;
}

.modal-help {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 1 0 0 0;
    color: #777777;
    content-align: left middle;
}

#session-summary {
    color: #e5a93c;
    margin: 0 0 1 0;
}

.modal Input {
    height: 3;
    margin: 0 0 1 0;
    border: round #333333;
    background: #1a1a1a;
    color: #e5e5e5;
}

.modal Input:focus {
    border: round #e5a93c;
}

.modal OptionList {
    height: 1fr;
    min-height: 6;
    border: round #2e2e2e;
    background: #111111;
    color: #d4d4d4;
}

.modal OptionList:focus {
    border: round #e5a93c;
}

.modal OptionList > .option-list--option-highlighted {
    background: #2d2618;
    color: #e5a93c;
    text-style: bold;
    border-left: wide #e5a93c;
}

.details {
    height: 1fr;
    min-height: 5;
    margin: 1 0 0 0;
    padding: 0 1;
    border: round #2e2e2e;
    background: #101010;
    color: #b8b8b8;
}

.modal TextArea {
    height: 8;
    margin: 0 0 1 0;
    border: round #333333;
    background: #1a1a1a;
    color: #e5e5e5;
}

.modal TextArea:focus {
    border: round #e5a93c;
}

.button-row {
    width: 100%;
    height: auto;
    align: right middle;
    margin: 1 0 0 0;
}

.button-row Button {
    width: auto;
    min-width: 10;
    height: 1;
    margin: 0 0 0 1;
    border: none;
    background: #242424;
    color: #d4d4d4;
    text-style: none;
}

.button-row Button:hover {
    background: #333333;
    color: #ffffff;
}

.button-row Button:focus {
    background: #8a6a1f;
    color: #ffffff;
    text-style: bold;
}

.button-row Button.-primary {
    background: #8a6a1f;
    color: #ffffff;
}

.button-row Button.-error {
    background: #7a2f2f;
    color: #ffffff;
}

.error-text {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
    color: #e06c75;
}

